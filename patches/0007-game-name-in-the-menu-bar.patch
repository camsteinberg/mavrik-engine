+/* The name for the link: the window server keeps at most 31 bytes of a
+ * process's name, and none of it when the cut falls inside a character.
+ * A file name cannot hold '/', so it becomes U+2215 (division slash), and
+ * control characters (C0, DEL and C1) are dropped.  NULL when nothing
+ * usable is left.
+ */
+static char *link_name(const char *name)
+{
+    char *ret = malloc(32);
+    size_t len = 0;
+
+    while (*name)
+    {
+        const unsigned char *c = (const unsigned char *)name;
+        const char *piece = name;
+        size_t piece_len = 1, used = 1;
+
+        if (c[0] < 0x20 || c[0] == 0x7f || (c[0] == 0xc2 && c[1] >= 0x80 && c[1] <= 0x9f))
+        {
+            name += c[0] == 0xc2 ? 2 : 1;
+            continue;
+        }
+        if (c[0] == '/')
+            piece = "\xe2\x88\x95", piece_len = 3;
+        else
+        {
+            /* a UTF-8 lead byte and its continuation bytes go together */
+            while ((c[used] & 0xc0) == 0x80) used++;
+            piece_len = used;
+        }
+        if (len + piece_len > 31) break;
+        memcpy(ret + len, piece, piece_len);
+        len += piece_len;
+        name += used;
+    }
+    ret[len] = 0;
+
+    if (!len || !strcmp(ret, ".") || !strcmp(ret, ".."))
+    {
+        free(ret);
+        return NULL;
+    }
     return ret;
 }
 
