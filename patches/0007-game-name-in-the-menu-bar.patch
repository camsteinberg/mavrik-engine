+/* The name for the link.  The window server shows a process's name
+ * decomposed (NFD), keeps at most 31 bytes of that, and none of it when the
+ * cut falls inside a character.  So the name is cut between whole
+ * characters where its decomposed UTF-8 form still fits in 31 bytes.  A
+ * file name cannot hold '/', so it becomes U+2215 (division slash), and
+ * control characters (C0, DEL and C1) are dropped.  NULL when nothing usable
+ * is left.
+ *
+ * link_name_exact measures the decomposed form with Core Foundation, which
+ * aborts in a forked child, so it runs once at start-up (title_link_name).
+ * link_name_bounded runs anywhere: each character counts as the most it can
+ * decompose to (6, 9 and 12 bytes for a 2, 3 and 4-byte character).
+ */
+static char *link_name_exact(const char *name)
+{
+    static const UniChar division_slash = 0x2215;
+    CFStringRef str = CFStringCreateWithCString(NULL, name, kCFStringEncodingUTF8);
+    CFMutableStringRef out;
+    CFIndex i = 0, len, used = 0, size;
+    char *ret = NULL;
+
+    if (!str)
+        return NULL;
+    out = CFStringCreateMutable(NULL, 0);
+    len = CFStringGetLength(str);
+    while (i < len)
+    {
+        CFRange range = CFStringGetRangeOfComposedCharactersAtIndex(str, i);
+        UniChar c = CFStringGetCharacterAtIndex(str, i);
+        CFStringRef piece;
+        CFMutableStringRef decomposed;
+        CFIndex bytes = 0;
+
+        i = range.location + range.length;
+        if (c < 0x20 || (c >= 0x7f && c <= 0x9f))
+            continue;
+        if (c == '/')
+            piece = CFStringCreateWithCharacters(NULL, &division_slash, 1);
+        else
+            piece = CFStringCreateWithSubstring(NULL, str, range);
+        decomposed = CFStringCreateMutableCopy(NULL, 0, piece);
+        CFStringNormalize(decomposed, kCFStringNormalizationFormD);
+        CFStringGetBytes(decomposed, CFRangeMake(0, CFStringGetLength(decomposed)), kCFStringEncodingUTF8, 0,
+                         false, NULL, 0, &bytes);
+        CFRelease(decomposed);
+        if (used + bytes <= 31)
+            CFStringAppend(out, piece);
+        CFRelease(piece);
+        if (used + bytes > 31)
+            break;
+        used += bytes;
+    }
+    CFRelease(str);
+
+    size = CFStringGetMaximumSizeForEncoding(CFStringGetLength(out), kCFStringEncodingUTF8) + 1;
+    if (used && (ret = malloc(size)) && !CFStringGetCString(out, ret, size, kCFStringEncodingUTF8))
+    {
+        free(ret);
+        ret = NULL;
+    }
+    CFRelease(out);
+
+    if (ret && (!strcmp(ret, ".") || !strcmp(ret, "..")))
+    {
+        free(ret);
+        ret = NULL;
+    }
     return ret;
 }
 
+static char *link_name_bounded(const char *name)
+{
+    static const size_t most[5] = { 0, 1, 6, 9, 12 };
+    char *ret = malloc(32);
+    size_t len = 0, used_nfd = 0;
+
+    if (!ret)
+        return NULL;
+    while (*name)
+    {
+        const unsigned char *c = (const unsigned char *)name;
+        const char *piece = name;
+        size_t piece_len = 1, used = 1;
+
+        if (c[0] < 0x20 || c[0] == 0x7f || (c[0] == 0xc2 && c[1] >= 0x80 && c[1] <= 0x9f))
+        {
+            name += c[0] == 0xc2 ? 2 : 1;
+            continue;
+        }
+        if (c[0] == '/')
+            piece = "\xe2\x88\x95", piece_len = 3;
+        else
+        {
+            /* a UTF-8 lead byte and its continuation bytes go together */
+            while ((c[used] & 0xc0) == 0x80) used++;
+            piece_len = used;
+        }
+        /* a piece longer than 4 bytes is not UTF-8: stop there */
+        if (piece_len > 4 || len + piece_len > 31 || used_nfd + most[piece_len] > 31) break;
+        memcpy(ret + len, piece, piece_len);
+        len += piece_len;
+        used_nfd += most[piece_len];
+        name += used;
+    }
+    ret[len] = 0;
+
+    if (!len || !strcmp(ret, ".") || !strcmp(ret, ".."))
+    {
+        free(ret);
+        return NULL;
+    }
+    return ret;
+}
+
+/* WINEPRELOADERAPPNAME as it was at start-up, and its link name. */
+static char *title_at_start, *title_link_name;
+
+static void init_title_link_name(void)
+{
+    const char *title = getenv("WINEPRELOADERAPPNAME");
+
+    if (!title || !*title)
+        return;
+    title_at_start = strdup(title);
+    title_link_name = link_name_exact(title);
+}
