+/* The device a stream plays on now: one that follows the default may have moved since it was
+ * created. Never called with stream->lock held: the unit's own lock may be held by the I/O
+ * thread waiting in ca_render_cb for stream->lock. */
+static AudioDeviceID stream_dev_id(struct coreaudio_stream *stream)
+{
+    AudioDeviceID id;
+    UInt32 size = sizeof(id);
+
+    if(stream->follow_default &&
+       AudioUnitGetProperty(stream->unit, kAudioOutputUnitProperty_CurrentDevice,
+                            kAudioUnitScope_Global, 0, &id, &size) == noErr)
+        return id;
+    return stream->dev_id;
+}
