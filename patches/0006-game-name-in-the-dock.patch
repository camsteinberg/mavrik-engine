+/***********************************************************************
+ *              set_display_name
+ *
+ * Give the process the name the Dock and the app switcher show.  They
+ * take it from LaunchServices, which names a program that has no app
+ * bundle after its executable ("wine").  LaunchServices' private
+ * _LSSetApplicationInformationItem sets it from inside the process, as
+ * Chromium did for its helper processes and Firefox and WebKit do.  It
+ * is looked up at run time: on a macOS without it, the name stays as it
+ * was.
+ */
+static void set_display_name(NSString* name)
+{
+    typedef CFTypeRef (*LSGetCurrentApplicationASNFunc)(void);
+    typedef OSStatus (*LSSetApplicationInformationItemFunc)(int, CFTypeRef, CFStringRef, CFStringRef, CFDictionaryRef*);
+    static LSGetCurrentApplicationASNFunc pLSGetCurrentApplicationASN;
+    static LSSetApplicationInformationItemFunc pLSSetApplicationInformationItem;
+    static CFStringRef* pLSDisplayNameKey;
+    static dispatch_once_t once;
+    CFTypeRef asn;
+    OSStatus status;
+
+    dispatch_once(&once, ^{
+        void* handle = dlopen("/System/Library/Frameworks/CoreServices.framework/CoreServices", RTLD_LAZY | RTLD_LOCAL);
+        if (handle)
+        {
+            pLSGetCurrentApplicationASN = dlsym(handle, "_LSGetCurrentApplicationASN");
+            pLSSetApplicationInformationItem = dlsym(handle, "_LSSetApplicationInformationItem");
+            pLSDisplayNameKey = dlsym(handle, "_kLSDisplayNameKey");
+        }
+    });
+
+    if (![name length] || !pLSGetCurrentApplicationASN || !pLSSetApplicationInformationItem ||
+        !pLSDisplayNameKey || !*pLSDisplayNameKey)
+        return;
+    if (!(asn = pLSGetCurrentApplicationASN()))
+        return;
+    /* -2 is the current session, as WebKit and Chromium pass. */
+    status = pLSSetApplicationInformationItem(-2, asn, *pLSDisplayNameKey, (CFStringRef)name, NULL);
+    if (status)
+        ERR(@"could not set the display name: %d\n", (int)status);
 }
 
 
