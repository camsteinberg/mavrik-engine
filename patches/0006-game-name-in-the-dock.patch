 #ifdef __APPLE__
 #define min(a,b)   (((a) < (b)) ? (a) : (b))
 /***********************************************************************
+ *           copy_xml_name
+ *
+ * Copy as much of name (len bytes of UTF-8) as fits in max bytes of XML
+ * text: '&', '<' and '>' escaped, and never an escape or a character cut
+ * in half.  An unescaped '&' or '<' would make Core Foundation reject the
+ * whole Info.plist.  With dest NULL, only count.  Returns the bytes used.
+ */
+static size_t copy_xml_name( char* dest, size_t max, const char* name, size_t len )
+{
+    size_t in = 0, out = 0;
+
+    while (in < len)
+    {
+        const char* piece = name + in;
+        size_t piece_len = 1, used = 1;
+
+        if (name[in] == '&') piece = "&amp;", piece_len = 5;
+        else if (name[in] == '<') piece = "&lt;", piece_len = 4;
+        else if (name[in] == '>') piece = "&gt;", piece_len = 4;
+        else
+        {
+            /* a UTF-8 lead byte and its continuation bytes go together */
+            while (in + used < len && (name[in + used] & 0xc0) == 0x80) used++;
+            piece_len = used;
+        }
+
+        if (out + piece_len > max) break;
+        if (dest) memcpy(dest + out, piece, piece_len);
+        out += piece_len;
+        in += used;
+    }
+    return out;
+}
