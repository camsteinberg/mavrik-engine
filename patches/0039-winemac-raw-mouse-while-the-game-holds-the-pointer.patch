diff --git a/dlls/winemac.drv/cocoa_rawmouse.m b/dlls/winemac.drv/cocoa_rawmouse.m
new file mode 100644
index 0000000..cca8fce
--- /dev/null
+++ b/dlls/winemac.drv/cocoa_rawmouse.m
@@ -0,0 +1,269 @@
+/*
+ * MACDRV raw mouse input
+ *
+ * mavrik, after Recall's wine-mouselook.patch (github.com/AsherJN/recall at
+ * 7aa7fb3, Josh Nelson; a change to Wine, LGPL-2.1-or-later): while a game
+ * hides the cursor and holds the pointer, the Mac driver stops the Mac
+ * pointer and sends the game a mouse's own counts from GameController's
+ * GCMouse (once per device report, with none of macOS's pointer
+ * acceleration) as relative moves, as Windows' raw input does. AppKit's
+ * mouse deltas, which carry macOS's acceleration and arrive about once per
+ * display frame, stay the path for the trackpad. cocoa_app.m decides when
+ * raw mode is on; this file holds the GCMouse side. The code was written for
+ * this tree.
+ *
+ * Copyright 2026 the mavrik-engine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#import <GameController/GameController.h>
+#include <os/lock.h>
+#include <time.h>
+
+#import "cocoa_app.h"
+#import "cocoa_event.h"
+#import "cocoa_window.h"
+
+
+/* At most one relative move a millisecond goes to the game (Recall's
+ * default); the rest is added up and the remainder kept. */
+#define RAW_MOUSE_INTERVAL_NS (1 * NSEC_PER_MSEC)
+
+/* Shared between the main thread (start, stop, AppKit's moves) and the
+ * handler queue, under raw_mouse_lock. */
+static os_unfair_lock raw_mouse_lock = OS_UNFAIR_LOCK_INIT;
+static WineWindow* raw_mouse_window;        /* retained; nil while raw mode is off */
+static WineEventQueue* raw_mouse_event_queue;   /* its queue, retained */
+static double raw_mouse_pending_x, raw_mouse_pending_y;
+static uint64_t raw_mouse_last_post;        /* CLOCK_UPTIME_RAW, ns */
+static uint64_t raw_mouse_last_report;      /* the last GCMouse report, CLOCK_UPTIME_RAW, ns */
+static BOOL raw_mouse_flush_pending;
+
+/* Main thread only. */
+static dispatch_queue_t raw_mouse_queue;
+static NSMutableArray* raw_mouse_devices;   /* the GCMouse objects whose handler is ours */
+static BOOL raw_mouse_observing;
+
+int macdrv_raw_mouse_on;                    /* read by mouse.c's GetCursorPos and SetCursorPos */
+
+
+/* Is this GameController mouse one whose counts the game gets?  The built-in
+ * and Magic Trackpad keep AppKit's accelerated path (the player's choice,
+ * mavrik S217); Recall tells them apart by the device's vendorName. Kept in
+ * one function, as the mouse probe may still change the test. */
+static BOOL raw_mouse_device_counts(GCMouse* mouse)
+{
+    NSString* name = mouse.vendorName;
+
+    return !(name && [name rangeOfString:@"Trackpad" options:NSCaseInsensitiveSearch].location != NSNotFound);
+}
+
+static void raw_mouse_flush(void);
+
+static void raw_mouse_schedule_flush(uint64_t delay_ns)
+{
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, delay_ns), raw_mouse_queue, ^{
+        os_unfair_lock_lock(&raw_mouse_lock);
+        raw_mouse_flush_pending = FALSE;
+        os_unfair_lock_unlock(&raw_mouse_lock);
+        raw_mouse_flush();
+    });
+}
+
+/* On the handler queue: sends the whole counts added up so far as one
+ * relative move, at most once per RAW_MOUSE_INTERVAL_NS; what arrives sooner
+ * waits for one flush. */
+static void raw_mouse_flush(void)
+{
+    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW), wait = 0;
+    WineEventQueue* queue = nil;
+    macdrv_event* event = NULL;
+
+    os_unfair_lock_lock(&raw_mouse_lock);
+    if (raw_mouse_window && ((int)raw_mouse_pending_x || (int)raw_mouse_pending_y))
+    {
+        if (now - raw_mouse_last_post >= RAW_MOUSE_INTERVAL_NS)
+        {
+            event = macdrv_create_event(MOUSE_MOVED_RELATIVE, raw_mouse_window);
+            event->mouse_moved.x = (int)raw_mouse_pending_x;
+            event->mouse_moved.y = (int)raw_mouse_pending_y;
+            raw_mouse_pending_x -= event->mouse_moved.x;
+            raw_mouse_pending_y -= event->mouse_moved.y;
+            raw_mouse_last_post = now;
+            queue = [raw_mouse_event_queue retain];
+        }
+        else if (!raw_mouse_flush_pending)
+        {
+            raw_mouse_flush_pending = TRUE;
+            wait = RAW_MOUSE_INTERVAL_NS - (now - raw_mouse_last_post);
+        }
+    }
+    os_unfair_lock_unlock(&raw_mouse_lock);
+
+    if (event)
+    {
+        /* The queue adds this to a move the Wine thread hasn't read yet. */
+        event->mouse_moved.drag = FALSE;
+        event->mouse_moved.time_ms = [[WineApplicationController sharedController] ticksForEventTime:now / (double)NSEC_PER_SEC];
+        [queue postEvent:event];
+        macdrv_release_event(event);
+        [queue release];
+    }
+    if (wait)
+        raw_mouse_schedule_flush(wait);
+}
+
+/* On the handler queue, once per device report. GameController's Y axis
+ * points up, Windows' down. */
+static void raw_mouse_moved(float dx, float dy)
+{
+    os_unfair_lock_lock(&raw_mouse_lock);
+    if (raw_mouse_window)
+    {
+        raw_mouse_pending_x += dx;
+        raw_mouse_pending_y -= dy;
+        raw_mouse_last_report = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    }
+    os_unfair_lock_unlock(&raw_mouse_lock);
+    raw_mouse_flush();
+}
+
+static void raw_mouse_attach(GCMouse* mouse)
+{
+    if (!raw_mouse_device_counts(mouse) || [raw_mouse_devices containsObject:mouse])
+        return;
+
+    [raw_mouse_devices addObject:mouse];
+    mouse.handlerQueue = raw_mouse_queue;
+    mouse.mouseInput.mouseMovedHandler = ^(GCMouseInput* input, float deltaX, float deltaY){
+        raw_mouse_moved(deltaX, deltaY);
+    };
+}
+
+static void raw_mouse_detach_all(void)
+{
+    for (GCMouse* mouse in raw_mouse_devices)
+    {
+        mouse.mouseInput.mouseMovedHandler = nil;
+        mouse.handlerQueue = dispatch_get_main_queue();
+    }
+    [raw_mouse_devices removeAllObjects];
+}
+
+/***********************************************************************
+ *              macdrv_raw_mouse_available
+ *
+ * Main thread. Is a mouse that counts connected?  The first call starts
+ * watching GameController's mice, so a mouse plugged in or taken away
+ * re-evaluates raw mode (changed is called on the main thread).
+ */
+BOOL macdrv_raw_mouse_available(void (^changed)(void))
+{
+    if (!raw_mouse_observing)
+    {
+        NSNotificationCenter* nc = [NSNotificationCenter defaultCenter];
+
+        raw_mouse_observing = TRUE;
+        raw_mouse_devices = [[NSMutableArray alloc] init];
+        raw_mouse_queue = dispatch_queue_create("org.winehq.wine.winemac.raw-mouse",
+                                                dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                                                        QOS_CLASS_USER_INTERACTIVE, 0));
+        [nc addObserverForName:GCMouseDidConnectNotification object:nil queue:[NSOperationQueue mainQueue]
+                    usingBlock:^(NSNotification* note){
+            if (macdrv_raw_mouse_on)
+                raw_mouse_attach(note.object);
+            changed();
+        }];
+        [nc addObserverForName:GCMouseDidDisconnectNotification object:nil queue:[NSOperationQueue mainQueue]
+                    usingBlock:^(NSNotification* note){
+            [raw_mouse_devices removeObject:note.object];
+            changed();
+        }];
+    }
+
+    for (GCMouse* mouse in [GCMouse mice])
+        if (raw_mouse_device_counts(mouse)) return TRUE;
+    return FALSE;
+}
+
+/***********************************************************************
+ *              macdrv_raw_mouse_start
+ *
+ * Main thread. Mouse counts from now on go to window as relative moves.
+ */
+void macdrv_raw_mouse_start(WineWindow* window)
+{
+    WineWindow* old_window;
+    WineEventQueue* old_queue;
+
+    os_unfair_lock_lock(&raw_mouse_lock);
+    old_window = raw_mouse_window;
+    old_queue = raw_mouse_event_queue;
+    raw_mouse_window = [window retain];
+    raw_mouse_event_queue = [window.queue retain];
+    raw_mouse_pending_x = raw_mouse_pending_y = 0;
+    os_unfair_lock_unlock(&raw_mouse_lock);
+    [old_window release];
+    [old_queue release];
+
+    if (!macdrv_raw_mouse_on)
+    {
+        macdrv_raw_mouse_on = TRUE;
+        for (GCMouse* mouse in [GCMouse mice])
+            raw_mouse_attach(mouse);
+    }
+}
+
+/***********************************************************************
+ *              macdrv_raw_mouse_stop
+ *
+ * Main thread. Ends raw mode's GCMouse side; counts not yet sent are dropped.
+ */
+void macdrv_raw_mouse_stop(void)
+{
+    WineWindow* window;
+    WineEventQueue* queue;
+
+    macdrv_raw_mouse_on = FALSE;
+    raw_mouse_detach_all();
+
+    os_unfair_lock_lock(&raw_mouse_lock);
+    window = raw_mouse_window;
+    queue = raw_mouse_event_queue;
+    raw_mouse_window = nil;
+    raw_mouse_event_queue = nil;
+    raw_mouse_pending_x = raw_mouse_pending_y = 0;
+    raw_mouse_last_report = 0;
+    os_unfair_lock_unlock(&raw_mouse_lock);
+    [window release];
+    [queue release];
+}
+
+/***********************************************************************
+ *              macdrv_raw_mouse_reported_within
+ *
+ * Did a mouse that counts report within the last ns nanoseconds?  AppKit's
+ * moves then describe the same motion and are dropped.
+ */
+BOOL macdrv_raw_mouse_reported_within(uint64_t ns)
+{
+    uint64_t last;
+
+    os_unfair_lock_lock(&raw_mouse_lock);
+    last = raw_mouse_last_report;
+    os_unfair_lock_unlock(&raw_mouse_lock);
+    return last && clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - last < ns;
+}
