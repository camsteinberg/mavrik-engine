     - (void) updateFullscreenWindows
     {
-        if (capture_displays_for_fullscreen && [NSApp isActive])
+        const NSApplicationPresentationOptions hideDockAndMenuBar = NSApplicationPresentationHideDock |
+                                                                    NSApplicationPresentationHideMenuBar;
+        NSApplicationPresentationOptions options;
+        BOOL anyFullscreen = FALSE;
+
+        if ([NSApp isActive])
         {
-            BOOL anyFullscreen = FALSE;
             NSNumber* windowNumber;
             for (windowNumber in [NSWindow windowNumbersWithOptions:0])
             {
@@ -1049,7 +1053,32 @@ - (void) updateFullscreenWindows
                     break;
                 }
             }
+        }
+
+        // While one of our windows covers a whole screen (outside a full-screen
+        // Space, where AppKit does this itself), hide the Dock and the menu bar.
+        // Our window sits above them, but the Dock still wakes at its edge of the
+        // screen and shows its arrow over a game that hides the cursor.  macOS
+        // applies presentation options only while we are the active app.
+        options = NSApp.presentationOptions;
+        if (anyFullscreen)
+            options |= hideDockAndMenuBar;
+        else
+            options &= ~hideDockAndMenuBar;
+        if (options != NSApp.presentationOptions)
+        {
+            NSApp.presentationOptions = options;
+
+            // Changing the presentation options can make macOS reset the cursor.
+            if ([NSApp isActive])
+            {
+                cursorNeedsReapply = TRUE;
+                [self updateCursor:TRUE];
+            }
+        }
 
+        if (capture_displays_for_fullscreen && [NSApp isActive])
+        {
             if (anyFullscreen)
             {
