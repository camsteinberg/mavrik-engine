+/***********************************************************************
+ *              FitBelowNotch's strips
+ *
+ * mavrik: FitBelowNotch. A full-screen game gets the area below the camera
+ * housing, and the strip beside the housing is black, as VLC and QuickTime
+ * Player do (NSPrefersDisplaySafeAreaCompatibilityMode is not used: it is
+ * read from an app bundle, changes the whole display on each activation and
+ * scales with black bars at the sides too).
+ *
+ * Each screen's strip is read on the main thread, when the Cocoa app starts
+ * and when the screens change, and kept here: the Unix side never reads
+ * AppKit for it, and notch_offset has one writer.
+ */
+struct notch_strip
+{
+    CGDirectDisplayID id;
+    CGRect bounds;      /* the screen in Quartz's top-down points, when read */
+    CGFloat strip;
+};
+
+static pthread_mutex_t notch_strips_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct notch_strip notch_strips[16];
+static int notch_strip_count;
+
+CGFloat notch_offset;
+
+/* The strip in points: the panel's own size below the camera, the tallest
+ * mode it lists at the screen's point width and a smaller height (1512x945 on
+ * a 14-inch MacBook Pro at its default 1512x982, so 37), else the 16:10 size
+ * below it; never less than the safe area's top inset (32 there, Apple's line
+ * for "not hidden by the housing"), nor more than twice it. 0 on a screen
+ * without a housing (an external display, a closed lid) or before macOS 12. */
+static CGFloat compute_notch_strip(NSScreen* screen, CGDirectDisplayID display_id)
+{
+    CGFloat safe = 0, strip = 0, width = NSWidth(screen.frame), height = NSHeight(screen.frame);
+    CFDictionaryRef options;
+    CFArrayRef modes = NULL;
+    size_t below = 0;
+    CFIndex i;
+
+    if (@available(macOS 12.0, *))
+        safe = ceil(screen.safeAreaInsets.top);
+    if (safe <= 0 || safe >= height / 4)
+        return 0;
+
+    options = CFDictionaryCreate(NULL, (const void**)&kCGDisplayShowDuplicateLowResolutionModes,
+                                 (const void**)&kCFBooleanTrue, 1, &kCFTypeDictionaryKeyCallBacks,
+                                 &kCFTypeDictionaryValueCallBacks);
+    modes = CGDisplayCopyAllDisplayModes(display_id, options);
+    if (options)
+        CFRelease(options);
+    for (i = 0; modes && i < CFArrayGetCount(modes); i++)
+    {
+        CGDisplayModeRef mode = (CGDisplayModeRef)CFArrayGetValueAtIndex(modes, i);
+        size_t mode_height = CGDisplayModeGetHeight(mode);
+
+        if (CGDisplayModeGetWidth(mode) == (size_t)width && mode_height < height && mode_height > below)
+            below = mode_height;
+    }
+    if (modes)
+        CFRelease(modes);
+
+    if (below)
+        strip = height - below;
+    if (strip < safe || strip > safe * 2)
+        strip = height - floor(width * 10 / 16);
+    if (strip < safe || strip > safe * 2)
+        strip = safe;
+    TRACE_NOTCH("display %u: %gx%g, safe area %g, listed below it %zu, strip %g pt\n", display_id, width, height,
+                safe, below, ceil(strip));
+    return ceil(strip);
+}
+
+/***********************************************************************
+ *              macdrv_refresh_notch_strips
+ *
+ * Reads every screen's strip again, and notch_offset, the primary screen's:
+ * where Windows' y=0 is. Main thread only: when the Cocoa app starts (before
+ * any Unix thread asks) and when the screens change.
+ */
+void macdrv_refresh_notch_strips(void)
+{
+@autoreleasepool
+{
+    struct notch_strip strips[sizeof(notch_strips) / sizeof(notch_strips[0])];
+    int count = 0;
+
+    if (!fit_below_notch)
+        return;
+    for (NSScreen* screen in [NSScreen screens])
+    {
+        NSNumber* number = [screen deviceDescription][@"NSScreenNumber"];
+
+        if (count >= sizeof(strips) / sizeof(strips[0]))
+            break;
+        strips[count].id = [number unsignedIntValue];
+        strips[count].bounds = CGDisplayBounds(strips[count].id);
+        strips[count].strip = number ? compute_notch_strip(screen, strips[count].id) : 0;
+        count++;
+    }
+
+    pthread_mutex_lock(&notch_strips_mutex);
+    memcpy(notch_strips, strips, count * sizeof(strips[0]));
+    notch_strip_count = count;
+    notch_offset = count ? strips[0].strip : 0;
+    pthread_mutex_unlock(&notch_strips_mutex);
+}
+}
+
+/***********************************************************************
+ *              macdrv_display_notch_strip
+ *
+ * The strip of the screen showing display_id, as last read; 0 without the
+ * option. Any thread.
+ */
+CGFloat macdrv_display_notch_strip(CGDirectDisplayID display_id)
+{
+    CGFloat strip = 0;
+    int i;
+
+    if (!fit_below_notch)
+        return 0;
+    pthread_mutex_lock(&notch_strips_mutex);
+    for (i = 0; i < notch_strip_count; i++)
+    {
+        if (notch_strips[i].id == display_id)
+        {
+            strip = notch_strips[i].strip;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&notch_strips_mutex);
+    return strip;
+}
+
+CGFloat macdrv_screen_notch_strip(NSScreen* screen)
+{
+    if (!fit_below_notch || !screen)
+        return 0;
+    return macdrv_display_notch_strip([[screen deviceDescription][@"NSScreenNumber"] unsignedIntValue]);
+}
+
+/* The frame Windows sees for screen: its frame without the strip (Cocoa's
+ * origin is at the bottom, so only the height changes). */
+NSRect macdrv_screen_wine_frame(NSScreen* screen)
+{
+    NSRect frame = screen.frame;
+
+    frame.size.height -= macdrv_screen_notch_strip(screen);
+    return frame;
+}
+
+/***********************************************************************
+ *              macdrv_clamp_point_below_notch
+ *
+ * An absolute position (Quartz's top-down points) in a screen's strip is
+ * moved down to the strip's bottom edge, the top of the screen's Windows
+ * frame, so Windows never gets a position above it: the pointer over the
+ * black strip is at the game's top edge, as at a real screen's top. Returns
+ * whether the point was in a strip. Any thread.
+ */
+BOOL macdrv_clamp_point_below_notch(CGPoint* point)
+{
+    BOOL clamped = FALSE;
+    int i;
+
+    if (!fit_below_notch)
+        return FALSE;
+    pthread_mutex_lock(&notch_strips_mutex);
+    for (i = 0; i < notch_strip_count; i++)
+    {
+        CGRect bounds = notch_strips[i].bounds;
+
+        if (notch_strips[i].strip > 0 && CGRectContainsPoint(bounds, *point) &&
+            point->y < CGRectGetMinY(bounds) + notch_strips[i].strip)
+        {
+            point->y = CGRectGetMinY(bounds) + notch_strips[i].strip;
+            clamped = TRUE;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&notch_strips_mutex);
+    return clamped;
+}
