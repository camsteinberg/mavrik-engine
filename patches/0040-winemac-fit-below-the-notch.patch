--- a/dlls/winemac.drv/macdrv_cocoa.h
+++ b/dlls/winemac.drv/macdrv_cocoa.h
@@ -147,6 +147,9 @@
 extern bool retina_enabled;  /* Whether Retina mode is enabled via registry setting. */
 extern bool retina_on;       /* Whether Retina mode is currently active (enabled and display is in default mode). */
 extern bool enable_app_nap;
+extern bool fit_below_notch;    /* mavrik: FitBelowNotch, see cocoa_display.m */
+extern CGFloat notch_offset;    /* mavrik: the primary screen's strip in points while FitBelowNotch is on, else 0 */
+extern CGFloat macdrv_display_notch_strip(CGDirectDisplayID display_id);
 
 /* mavrik: pad buttons bound to macOS system gestures go to the game, see cocoa_gamepad.m */
 extern void macdrv_start_gamepad_gestures(void);
@@ -225,6 +228,37 @@ static inline CGPoint cgpoint_win_from_mac(CGPoint point)
     return point;
 }
 
+/* mavrik: an absolute screen position (Quartz's top-down points) and Windows'
+ * desktop coordinates. With FitBelowNotch, Windows' y=0 is the bottom of the
+ * primary screen's strip beside the camera housing (notch_offset); otherwise
+ * these equal the cg*_win_from_mac and cg*_mac_from_win above. Sizes, and
+ * positions inside a window, use those. */
+static inline CGRect cgrect_win_from_screen(CGRect rect)
+{
+    rect.origin.y -= notch_offset;
+    return cgrect_win_from_mac(rect);
+}
+
+static inline CGRect cgrect_screen_from_win(CGRect rect)
+{
+    rect = cgrect_mac_from_win(rect);
+    rect.origin.y += notch_offset;
+    return rect;
+}
+
+static inline CGPoint cgpoint_win_from_screen(CGPoint point)
+{
+    point.y -= notch_offset;
+    return cgpoint_win_from_mac(point);
+}
+
+static inline CGPoint cgpoint_screen_from_win(CGPoint point)
+{
+    point = cgpoint_mac_from_win(point);
+    point.y += notch_offset;
+    return point;
+}
+
