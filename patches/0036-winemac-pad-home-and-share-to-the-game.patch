+/*
+ * MACDRV game controller system gestures
+ *
+ * mavrik, from neutron's 0017 (github.com/fourlexboehm/neutron): games read
+ * pads in winedevice (winebus through SDL), a background process. macOS binds
+ * a pad's Home or PS button (Launchpad, the Game Overlay) and its Share or
+ * Create button (screenshots, recording) to system gestures and applies them
+ * for the frontmost app, which is the game's Wine process. So this process
+ * asks GameController to leave those buttons to the game, as a native game
+ * does. MAVRIK_PAD_SYSTEM_GESTURES=1 keeps the macOS gestures.
+ *
+ * Copyright 2026 the neutron contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#import <GameController/GameController.h>
+
+#include "macdrv_cocoa.h"
+
+
+static void disable_system_gestures(GCController* controller)
+{
+    GCPhysicalInputProfile* profile = controller.physicalInputProfile;
+
+    for (NSString* name in profile.buttons)
+    {
+        GCControllerButtonInput* button = profile.buttons[name];
+
+        if (!button.boundToSystemGesture) continue;
+        button.preferredSystemGestureState = GCSystemGestureStateDisabled;
+    }
+}
+
+/***********************************************************************
+ *              macdrv_start_gamepad_gestures
+ *
+ * Turn the system gestures off for every connected and future pad. The
+ * handlers run on the main queue.
+ */
+void macdrv_start_gamepad_gestures(void)
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [[NSNotificationCenter defaultCenter] addObserverForName:GCControllerDidConnectNotification
+                                                          object:nil
+                                                           queue:nil
+                                                      usingBlock:^(NSNotification* note){
+            disable_system_gestures(note.object);
+        }];
+
+        for (GCController* controller in [GCController controllers])
+            disable_system_gestures(controller);
+    });
+}
