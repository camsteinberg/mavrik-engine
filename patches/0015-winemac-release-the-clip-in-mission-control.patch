+    /* While we are the active app, mouse events can still go to another
+     * process: Mission Control, App Exposé and the like belong to the Dock, and
+     * we don't resign active for them.  The window server keeps a confinement
+     * rect then, and macOS shows its own cursor.  A global monitor sees only
+     * those events, so it is cheap while it is installed (only while active). */
+    - (void) startWatchingOtherProcessMouseEvents
+    {
+        NSEventMask mask = NSEventMaskMouseMoved | NSEventMaskLeftMouseDragged |
+                           NSEventMaskRightMouseDragged | NSEventMaskOtherMouseDragged |
+                           NSEventMaskLeftMouseDown | NSEventMaskRightMouseDown |
+                           NSEventMaskOtherMouseDown;
+
+        if (otherProcessMouseMonitor)
+            return;
+
+        otherProcessMouseMonitor = [[NSEvent addGlobalMonitorForEventsMatchingMask:mask
+                                                                          handler:^(NSEvent* event){
+            [self handleMouseEventForOtherProcess];
+        }] retain];
+    }
+
+    - (void) stopWatchingOtherProcessMouseEvents
+    {
+        if (!otherProcessMouseMonitor)
+            return;
+
+        [NSEvent removeMonitor:otherProcessMouseMonitor];
+        [otherProcessMouseMonitor release];
+        otherProcessMouseMonitor = nil;
+    }
+
+    - (void) handleMouseEventForOtherProcess
+    {
+        // As in the event tap clipping handler: don't clip events destined for
+        // another process, and treat our next mouse move as absolute.
+        if (self.clippingCursor && [clipCursorHandler respondsToSelector:@selector(suspendClippingCursor)])
+            [clipCursorHandler suspendClippingCursor];
+        forceNextMouseMoveAbsolute = TRUE;
+
+        // macOS shows its own cursor there; set ours again when the mouse is back.
+        cursorNeedsReapply = TRUE;
+    }
+
+    - (void) resumeCursorClippingIfSuspended
+    {
+        if (self.clippingCursor && [clipCursorHandler respondsToSelector:@selector(resumeClippingCursor)] &&
+            [clipCursorHandler resumeClippingCursor])
+        {
+            [self setCursorPosition:NSPointToCGPoint([self flippedMouseLocation:[NSEvent mouseLocation]])];
+        }
+    }
+
