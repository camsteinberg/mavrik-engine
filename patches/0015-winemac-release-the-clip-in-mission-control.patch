+bool macdrv_cursor_trace_on;
+
+
+/* A +cursor trace line from the Cocoa side, which has no debug channels of
+ * its own (macdrv_main.c sets macdrv_cursor_trace_on). */
+static void cursor_trace(const char* func, const char* format, ...) __attribute__((format(printf, 2, 3)));
+static void cursor_trace(const char* func, const char* format, ...)
+{
+    char message[256];
+    va_list args;
+
+    va_start(args, format);
+    vsnprintf(message, sizeof(message), format, args);
+    va_end(args);
+    fprintf(stderr, "trace:cursor:%s %s", func, message);
+}
+
+#define TRACE_CURSOR(...) do { if (macdrv_cursor_trace_on) cursor_trace(__func__, __VA_ARGS__); } while (0)
+
+
+/* The system overlay watch's state.  Once the watch has started, only its
+ * serial queue touches it; the timer's cancel handler frees it. */
+#define SYSTEM_OVERLAY_MAX_READ_TIMES 600
+
+struct system_overlay_watch
+{
+    pid_t owner_pid;            /* WindowManager's */
+    CGRect clip_rect;
+    int last_shown;             /* -1 until the first read */
+    int gone_reads;             /* "gone" reads in a row while "shown" was last reported */
+    int failed_reads;           /* window list reads in a row that failed */
+    unsigned int reads;
+    unsigned int read_us[SYSTEM_OVERLAY_MAX_READ_TIMES];
+    uint64_t period_start;      /* CLOCK_UPTIME_RAW, in nanoseconds */
+};
+
+/* Is Mission Control or App Exposé shown on the display that holds the clip
+ * rect?  On macOS 27 both draw a window of WindowManager's at layer 19 that
+ * covers the whole display; WindowManager puts no other window above the
+ * desktop level, except Show Desktop's at layer 18, and the Dock's own window
+ * (layer 20) covers the whole display at all times, so it says nothing (mavrik
+ * measured each state's window list, S215).  This uses only CoreGraphics, so
+ * it runs off the main thread, and it needs no permission: window titles are
+ * withheld without Screen Recording, but the owner, level and bounds are not.
+ * If a later macOS draws these overlays differently, this never fires, which
+ * leaves the confinement as Wine keeps it.  Returns -1 if the window list
+ * can't be read. */
+#define SYSTEM_OVERLAY_LAYER 19
+
+static int system_overlay_shown(pid_t owner_pid, CGRect clip_rect)
+{
+    CGPoint center = CGPointMake(CGRectGetMidX(clip_rect), CGRectGetMidY(clip_rect));
+    CGDirectDisplayID display;
+    uint32_t count = 0;
+    CGRect display_bounds;
+    CFArrayRef windows;
+    CFIndex i, n;
+    int shown = 0;
+
+    if (owner_pid <= 0)
+        return 0;
+
+    if ((CGGetDisplaysWithPoint(center, 1, &display, &count) != kCGErrorSuccess || !count) &&
+        (CGGetDisplaysWithRect(clip_rect, 1, &display, &count) != kCGErrorSuccess || !count))
+        return 0;
+    display_bounds = CGDisplayBounds(display);
+
+    windows = CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly, kCGNullWindowID);
+    if (!windows)
+        return -1;
+
+    n = CFArrayGetCount(windows);
+    for (i = 0; i < n && !shown; i++)
+    {
+        CFDictionaryRef info = CFArrayGetValueAtIndex(windows, i);
+        CFNumberRef number;
+        CFDictionaryRef bounds_dict;
+        int pid, layer;
+        CGRect bounds;
+
+        number = CFDictionaryGetValue(info, kCGWindowOwnerPID);
+        if (!number || !CFNumberGetValue(number, kCFNumberIntType, &pid) || pid != owner_pid)
+            continue;
+        number = CFDictionaryGetValue(info, kCGWindowLayer);
+        if (!number || !CFNumberGetValue(number, kCFNumberIntType, &layer) || layer != SYSTEM_OVERLAY_LAYER)
+            continue;
+        bounds_dict = CFDictionaryGetValue(info, kCGWindowBounds);
+        if (!bounds_dict || !CGRectMakeWithDictionaryRepresentation(bounds_dict, &bounds))
+            continue;
+        if (CGRectContainsRect(CGRectInset(bounds, -1, -1), display_bounds))
+            shown = 1;
+    }
+
+    CFRelease(windows);
+    return shown;
+}
+
+static int compare_read_times(const void* a, const void* b)
+{
+    unsigned int x = *(const unsigned int*)a, y = *(const unsigned int*)b;
+    return x < y ? -1 : x > y;
+}
+
+static void system_overlay_report_read_times(struct system_overlay_watch* watch)
+{
+    if (!watch->reads)
+        return;
+
+    qsort(watch->read_us, watch->reads, sizeof(watch->read_us[0]), compare_read_times);
+    TRACE_CURSOR("system overlay watch: window list read median %u us, worst %u us over %u reads\n",
+                 watch->read_us[watch->reads / 2], watch->read_us[watch->reads - 1], watch->reads);
+    watch->reads = 0;
+}
+
+/* Two "gone" reads in a row end an overlay: inside Mission Control the
+ * player can move to App Exposé or another Space, and one read may fall in
+ * the gap between WindowManager's windows.  Three failed reads in a row count as
+ * "gone", so a window list that stops answering never leaves the pointer
+ * free (and the game's warps skipped) for good. */
+#define SYSTEM_OVERLAY_GONE_READS 2
+#define SYSTEM_OVERLAY_FAILED_READS 3
+
+/* One read of the watch, on its queue.  Under +cursor, the read's time is
+ * kept and reported once a minute. */
+static int system_overlay_check(struct system_overlay_watch* watch)
+{
+    uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW), end;
+    int shown = system_overlay_shown(watch->owner_pid, watch->clip_rect);
+
+    if (macdrv_cursor_trace_on)
+    {
+        end = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        if (watch->reads < SYSTEM_OVERLAY_MAX_READ_TIMES)
+            watch->read_us[watch->reads++] = (unsigned int)((end - start) / 1000);
+        if (end - watch->period_start >= 60 * NSEC_PER_SEC)
+        {
+            system_overlay_report_read_times(watch);
+            watch->period_start = end;
+        }
+    }
+
+    return shown;
+}
 
 
