+    /* The window server keeps a confinement rect while the app is frontmost
+     * and the window is key, which stays true in Mission Control and App
+     * Exposé, so the pointer could not leave the window's area there.  The
+     * event tap handler lets such events through unclipped; do the same by
+     * removing the rect until the mouse is back over one of our windows. */
+    - (void) suspendClippingCursor
+    {
+        if (!clippingCursor || clippingSuspended)
+            return;
+
+        NSWindow *ownerWindow = [NSApp windowWithWindowNumber:clippingWindowNumber];
+        [ownerWindow setMouseConfinementRect:NSZeroRect];
+        clippingSuspended = TRUE;
+    }
+
+    - (BOOL) resumeClippingCursor
+    {
+        if (!clippingCursor || !clippingSuspended)
+            return FALSE;
+
+        if ([self startClippingCursor:cursorClipRect])
+            return TRUE;
+
+        /* No window to confine to yet; stay suspended and try again later. */
+        clippingCursor = TRUE;
+        clippingSuspended = TRUE;
+        return FALSE;
+    }
+
