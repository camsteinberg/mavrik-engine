+    - (WineConfinementClipCursorHandler*) confinementClipCursorHandler
+    {
+        if ([clipCursorHandler isKindOfClass:[WineConfinementClipCursorHandler class]])
+            return (WineConfinementClipCursorHandler*)clipCursorHandler;
+        return nil;
