+     * this way, a timer on a background queue reads the window list every
+     * 100 ms and reports a change of system_overlay_shown() to the main thread.
+     */
+    - (pid_t) overlayOwnerProcessIdentifier
+    {
+        if (!overlayOwnerApplication || overlayOwnerApplication.terminated)
+        {
+            [overlayOwnerApplication release];
+            overlayOwnerApplication = [[[NSRunningApplication runningApplicationsWithBundleIdentifier:@"com.apple.WindowManager"] firstObject] retain];
+        }
+        return overlayOwnerApplication ? overlayOwnerApplication.processIdentifier : -1;
+    }
+
+    - (void) stopSystemOverlayWatch
+    {
+        // Reports already on their way to the main thread are dropped.
+        systemOverlayWatchGeneration++;
+        if (!systemOverlayTimer)
+            return;
+
+        // The cancel handler runs on the watch's queue after any read in
+        // progress and frees the watch's state there.
+        dispatch_source_cancel(systemOverlayTimer);
+        dispatch_release(systemOverlayTimer);
+        systemOverlayTimer = NULL;
+    }
+
+    - (void) startSystemOverlayWatch
+    {
+        struct system_overlay_watch* watch;
+        dispatch_source_t timer;
+        unsigned int generation;
+
+        [self stopSystemOverlayWatch];
+
+        if (!systemOverlayQueue)
+        {
+            dispatch_queue_attr_t attr = dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                                                 QOS_CLASS_UTILITY, 0);
+            systemOverlayQueue = dispatch_queue_create("org.winehq.wine.system-overlay-watch", attr);
+            if (!systemOverlayQueue)
+                return;
+        }
+
+        watch = calloc(1, sizeof(*watch));
+        if (!watch)
+            return;
+        watch->owner_pid = [self overlayOwnerProcessIdentifier];
+        watch->clip_rect = clipCursorHandler.cursorClipRect;
+        watch->last_shown = -1;
+        watch->period_start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+
+        timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, systemOverlayQueue);
+        if (!timer)
+        {
+            free(watch);
+            return;
+        }
+
+        generation = systemOverlayWatchGeneration;
+        dispatch_source_set_event_handler(timer, ^{
+            int shown = system_overlay_check(watch);
+
+            if (shown < 0)
+            {
+                if (++watch->failed_reads < SYSTEM_OVERLAY_FAILED_READS)
+                    return;
+                shown = 0;
+            }
+            else
+                watch->failed_reads = 0;
+
+            if (shown || watch->last_shown != 1)
+                watch->gone_reads = 0;
+            else if (++watch->gone_reads < SYSTEM_OVERLAY_GONE_READS)
+                return;
+
+            if (shown != watch->last_shown)
+            {
+                watch->last_shown = shown;
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    [self systemOverlayRead:shown generation:generation];
+                });
+            }
+        });
+        dispatch_source_set_cancel_handler(timer, ^{
+            system_overlay_report_read_times(watch);
+            free(watch);
+        });
+        // The first read is at once.
+        dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, 0), 100 * NSEC_PER_MSEC, 20 * NSEC_PER_MSEC);
+
+        systemOverlayTimer = timer;
+        systemOverlayWatchRect = watch->clip_rect;
+        dispatch_resume(timer);
+    }
+
+    /* Starts, restarts or stops the watch as needed.  A restart reads at once
+     * and reports the result even if it hasn't changed.  If the game stops
+     * clipping while an overlay is shown, the watch runs on until it is
+     * gone. */
+    - (void) updateSystemOverlayWatch:(BOOL)checkNow
+    {
+        if (![NSApp isActive] || !(self.clippingCursor || systemOverlayShown) ||
+            ![self confinementClipCursorHandler])
+            [self stopSystemOverlayWatch];
+        else if (checkNow || !systemOverlayTimer ||
+                 !CGRectEqualToRect(systemOverlayWatchRect, clipCursorHandler.cursorClipRect))
+            [self startSystemOverlayWatch];
+    }
+
+    - (void) systemOverlayRead:(BOOL)shown generation:(unsigned int)generation
+    {
+        if (generation != systemOverlayWatchGeneration || !systemOverlayTimer)
+            return;
+
+        if (shown)
+            [self liftConfinementForSystemOverlay];
+        else
+        {
+            [self restoreConfinementAfterSystemOverlay];
+            [self updateSystemOverlayWatch:FALSE];
+        }
+    }
+
+    - (void) liftConfinementForSystemOverlay
+    {
+        WineConfinementClipCursorHandler* handler = [self confinementClipCursorHandler];
+
+        if (systemOverlayShown || !handler.clippingCursor)
+            return;
+
+        // The clip rect and the Windows side's clipping state are kept.
+        [handler suspendClippingCursor];
+        systemOverlayShown = TRUE;
+
+        // As the event tap handler does for events destined for another
+        // process: treat our next mouse move as absolute.  macOS shows its own
+        // cursor over the overlay, so set ours again after it.
+        forceNextMouseMoveAbsolute = TRUE;
+        cursorNeedsReapply = TRUE;
+
+        TRACE_CURSOR("system overlay shown: confinement lifted\n");
+    }
+
+    - (void) restoreConfinementAfterSystemOverlay
+    {
+        WineConfinementClipCursorHandler* handler = [self confinementClipCursorHandler];
+        BOOL wasShown;
+
+        // If we are not active, the window server keeps no confinement and
+        // Wine's ordinary path released the pointer; activation reads again.
+        if (![NSApp isActive])
+            return;
+
+        wasShown = systemOverlayShown;
+        systemOverlayShown = FALSE;
+
+        if (!handler.clippingSuspended)
+        {
+            if (wasShown)
+                TRACE_CURSOR("system overlay gone: no clip to restore\n");
+            return;
+        }
+
+        if ([handler resumeClippingCursor])
+        {
+            // As starting a clip does: move the pointer into the rect.
+            [self setCursorPosition:NSPointToCGPoint([self flippedMouseLocation:[NSEvent mouseLocation]])];
+
+            // Set the hidden cursor again, at once and once the overlay's
+            // animation has settled, as on activation.
+            cursorNeedsReapply = TRUE;
+            [self updateCursor:TRUE];
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 250 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                if ([NSApp isActive] && !systemOverlayShown)
+                {
+                    cursorNeedsReapply = TRUE;
+                    [self updateCursor:TRUE];
+                }
+            });
+
+            TRACE_CURSOR("system overlay gone: confinement restored\n");
+        }
+        else if (wasShown)
+            TRACE_CURSOR("system overlay gone: no window to confine to yet\n");
+    }
+
