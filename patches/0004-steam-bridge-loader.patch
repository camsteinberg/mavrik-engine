+/* Valve's Steam bridge (ValveSoftware/wine, proton_11.0): on unless PROTON_DISABLE_LSTEAMCLIENT is set. */
+static int use_lsteamclient(void)
+{
+    WCHAR env[32];
+    static int use = -1;
 
+    if (use != -1) return use;
+
+    use = !get_env( L"PROTON_DISABLE_LSTEAMCLIENT", env, sizeof(env) ) || *env == '0';
+    if (!use)
+        ERR("lsteamclient disabled.\n");
+    return use;
+}
