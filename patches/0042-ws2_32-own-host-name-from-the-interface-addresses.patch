+#ifdef HAVE_GETADDRINFO
+static void free_own_host_addrinfo( struct addrinfo *info )
+{
+    struct addrinfo *next;
+
+    for (; info; info = next)
+    {
+        next = info->ai_next;
+        free( info->ai_canonname );
+        free( info );
+    }
+}
+#endif
+
+#if defined(HAVE_GETADDRINFO) && defined(HAVE_GETIFADDRS)
+/* The machine's own name is answered from its interface addresses, as Windows does, with no lookup: macOS answers
+ * a .local name only by multicast DNS, which it holds behind its Local Network privacy prompt for an app bundle.
+ * Non-loopback IPv4 addresses come first, then non-loopback IPv6, then loopback; the IPv6 link-local addresses of
+ * point-to-point interfaces (tunnels) are left out. Each address gets the socket types, protocols and port that a
+ * lookup of no host gives for its family. */
+static int own_host_addrinfo( const char *host, const char *service, const struct addrinfo *hints,
+                              struct addrinfo **info )
+{
+    struct addrinfo tmpl_hints = {0}, *tmpl, *t, *ai, **next = info;
+    struct ifaddrs *ifaddrs, *ifa;
+    int ret, pass;
+
+    *info = NULL;
+    if (hints) tmpl_hints = *hints;
+    tmpl_hints.ai_flags &= ~(AI_CANONNAME | AI_PASSIVE);
+    if ((ret = getaddrinfo( NULL, service ? service : "0", &tmpl_hints, &tmpl ))) return ret;
+    if (getifaddrs( &ifaddrs ))
+    {
+        freeaddrinfo( tmpl );
+        return EAI_FAIL;
+    }
+    for (pass = 0; pass < 3; pass++)
+    {
+        for (ifa = ifaddrs; ifa; ifa = ifa->ifa_next)
+        {
+            int family = ifa->ifa_addr ? ifa->ifa_addr->sa_family : AF_UNSPEC;
+
+            if (!(ifa->ifa_flags & IFF_UP) || (family != AF_INET && family != AF_INET6)) continue;
+            if (pass != ((ifa->ifa_flags & IFF_LOOPBACK) ? 2 : family == AF_INET6)) continue;
+            if (family == AF_INET6 && (ifa->ifa_flags & IFF_POINTOPOINT)
+                    && IN6_IS_ADDR_LINKLOCAL( &((struct sockaddr_in6 *)ifa->ifa_addr)->sin6_addr ))
+                continue;
+            for (t = tmpl; t; t = t->ai_next)
+            {
+                if (t->ai_family != family) continue;
+                if (!(ai = malloc( sizeof(*ai) + sizeof(struct sockaddr_in6) )))
+                {
+                    ret = EAI_MEMORY;
+                    goto done;
+                }
+                *ai = *t;
+                ai->ai_canonname = NULL;
+                ai->ai_next = NULL;
+                *next = ai;
+                next = &ai->ai_next;
+                /* on every entry, as the system's own answer has it */
+                if (hints && (hints->ai_flags & AI_CANONNAME) && !(ai->ai_canonname = strdup( host )))
+                {
+                    ret = EAI_MEMORY;
+                    goto done;
+                }
+                ai->ai_addr = (struct sockaddr *)(ai + 1);
+                memcpy( ai->ai_addr, t->ai_addr, t->ai_addrlen ); /* the family and the port */
+                if (family == AF_INET)
+                    ((struct sockaddr_in *)ai->ai_addr)->sin_addr = ((struct sockaddr_in *)ifa->ifa_addr)->sin_addr;
+                else
+                {
+                    struct sockaddr_in6 *sin6 = (struct sockaddr_in6 *)ai->ai_addr;
+
+                    sin6->sin6_addr = ((struct sockaddr_in6 *)ifa->ifa_addr)->sin6_addr;
+#ifdef HAVE_STRUCT_SOCKADDR_IN6_SIN6_SCOPE_ID
+                    sin6->sin6_scope_id = ((struct sockaddr_in6 *)ifa->ifa_addr)->sin6_scope_id;
+                    if (IN6_IS_ADDR_LINKLOCAL( &sin6->sin6_addr ) && !sin6->sin6_scope_id)
+                    {
+                        /* BSD kernels keep a link-local address's scope in its third and fourth bytes */
+                        sin6->sin6_scope_id = (sin6->sin6_addr.s6_addr[2] << 8) | sin6->sin6_addr.s6_addr[3];
+                        sin6->sin6_addr.s6_addr[2] = sin6->sin6_addr.s6_addr[3] = 0;
+                    }
+#endif
+                }
+            }
+        }
+    }
+    if (!*info) ret = EAI_NONAME;
+done:
+    if (ret)
+    {
+        free_own_host_addrinfo( *info );
+        *info = NULL;
+    }
+    freeifaddrs( ifaddrs );
+    freeaddrinfo( tmpl );
+    return ret;
+}
+#endif
