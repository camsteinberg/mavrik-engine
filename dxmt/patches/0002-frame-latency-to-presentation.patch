@@ -1315,6 +1315,22 @@ _MTLCommandBuffer_presentDrawableAfterMinimumDuration(void *obj) {
   return STATUS_SUCCESS;
 }
 
+static NTSTATUS
+_MetalDrawable_signalEventWhenPresented(void *obj) {
+  struct unixcall_generic_obj_obj_uint64_noret *params = obj;
+  id<MTLSharedEvent> event = (id<MTLSharedEvent>)params->arg0;
+  uint64_t value = params->arg1;
+  [(id<MTLDrawable>)params->handle addPresentedHandler:^(id<MTLDrawable> _d) {
+    // NOTE: runs on a Core Animation thread without Wine's thread state, so it may only touch Metal.
+    // Dropped drawables are reported too. Never lower the value: a later frame may have been presented first.
+    // The read and the write are two steps, not one atomic step: if Core Animation ever ran two handlers at once,
+    // the value could drop by one frame, which costs one more refresh of waiting (or one 100 ms valve wait).
+    if (event.signaledValue < value)
+      event.signaledValue = value;
+  }];
+  return STATUS_SUCCESS;
+}
+
