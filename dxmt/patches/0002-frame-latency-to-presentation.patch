     chunk.reset();
   };
   event = device.newSharedEvent();
+  presented_event = device.newSharedEvent();
 
   std::string env = env::getEnvVar("DXMT_CAPTURE_FRAME");
 
@@ -224,6 +226,45 @@ CommandQueue::WaitForFinishThread() {
   return 0;
 }
 
+/**
+With vsync or a frame cap, finished frames wait in the layer's drawables for their turn on screen. Counting a frame
+against the latency limit until it is presented, as DXVK and Windows do, keeps those waits out of input latency.
+Without vsync a frame is presented as soon as it is finished, so only GPU completion counts.
+*/
+void
+CommandQueue::WaitFramePresented(uint64_t frame) {
+  // A window that is hidden or being torn down may never present. After one wait times out, stop waiting until a
+  // frame is presented again, so the game keeps running at its GPU pace.
+  constexpr uint64_t kPresentedTimeoutMs = 100;
+  if (!frame_signals_presented_[frame % kFrameSignalSlots].load(std::memory_order_relaxed))
+    return;
+  auto presented = presented_event.signaledValue();
+  if (presented >= frame) {
+    presented_wait_stalled_ = false;
+    return;
+  }
+  if (presented_wait_stalled_ && presented == presented_stalled_value_)
+    return;
+  presented_wait_stalled_ = false;
+  presented_event.waitUntilSignaledValue(frame, kPresentedTimeoutMs);
+  presented = presented_event.signaledValue();
+  if (presented < frame) {
+    // Logged at every entry into the stalled state, so a game that falls back often shows it. An entry needs a
+    // frame presented since the last one, which already spaces them out; at most one line a second besides.
+    static std::atomic<uint64_t> last_log_ms = 0, entries = 0;
+    auto entry = entries.fetch_add(1, std::memory_order_relaxed) + 1;
+    auto now_ms = (uint64_t)std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count();
+    auto last = last_log_ms.load(std::memory_order_relaxed);
+    if ((entry == 1 || now_ms - last >= 1000) && last_log_ms.compare_exchange_strong(last, now_ms))
+      WARN("Frame ", frame, " not presented within ", kPresentedTimeoutMs,
+           "ms; waiting for GPU completion only until a frame is presented (stall ", entry, " in this process)");
+    presented_wait_stalled_ = true;
+    presented_stalled_value_ = presented;
+  }
+}
